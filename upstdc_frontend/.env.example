# Frontend environment variables
# IMPORTANT: Orchestrator will inject actual values into .env for runtime.
# Base URL for backend API (FastAPI). Must point to port 3001 per requirements.
REACT_APP_API_BASE=http://localhost:3001

# Optional: Map defaults
REACT_APP_DEFAULT_LAT=26.8467
REACT_APP_DEFAULT_LNG=80.9462
REACT_APP_DEFAULT_ZOOM=6

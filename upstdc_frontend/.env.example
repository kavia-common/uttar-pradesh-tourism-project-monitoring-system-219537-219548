# Example environment variables for UPSTDC Frontend (React CRA)

# Bind dev server to all interfaces for preview environments
HOST=0.0.0.0
PORT=3000
BROWSER=none

# Backend API base (adjust per environment)
REACT_APP_API_BASE=http://localhost:3001

# Optional map defaults
# REACT_APP_DEFAULT_LAT=26.8467
# REACT_APP_DEFAULT_LNG=80.9462
# REACT_APP_DEFAULT_ZOOM=6

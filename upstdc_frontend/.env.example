# Frontend environment configuration
# Port binding for Create React App dev server (required for container preview)
PORT=3000
HOST=0.0.0.0

# Backend API base (adjust to your backend service URL)
REACT_APP_API_BASE=http://localhost:3001

# Optional map defaults
REACT_APP_DEFAULT_LAT=26.8467
REACT_APP_DEFAULT_LNG=80.9462
REACT_APP_DEFAULT_ZOOM=6

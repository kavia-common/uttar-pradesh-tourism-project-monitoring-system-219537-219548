{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.23.1",
    "react-scripts": "^5.0.1",
    "framer-motion": "^10.18.0",
    "cross-env": "^7.0.3"
  },
  "scripts": {
    "prestart": "node -e \"const fs=require('fs'); if(!fs.existsSync('node_modules')){console.log('[prestart] node_modules missing -> running install'); process.exit(1);} else {process.exit(0);}\" || npm run ci:install",
    "start": "cross-env HOST=0.0.0.0 PORT=3000 BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "test": "CI=true react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "postinstall": "echo \"Postinstall complete: dependencies ready\"",
    "ci:install": "npm ci --no-audit --no-fund || npm install --no-audit --no-fund"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/user-event": "^14.5.2"
  }
}
